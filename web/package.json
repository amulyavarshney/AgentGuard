{
  "name": "agentguard-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && VITE_BASE_PATH=/AgentGuard/ VITE_STATIC=true vite build",
    "preview": "vite preview",
    "preview:pages": "VITE_BASE_PATH=/AgentGuard/ VITE_STATIC=true vite preview --base /AgentGuard/"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.6"
  }
}
